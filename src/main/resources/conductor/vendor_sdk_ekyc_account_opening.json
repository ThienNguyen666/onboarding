  "name": "vendor_sdk_ekyc_account_opening",
  "description": "Workflow chỉ nhận input đã sẵn sàng từ pre-flow (CVP/device-check/phone/ETB-NTB/dropoff/TnC/OCR-Liveness-NFC mock đều xử lý bên ngoài Orkes). Trong Orkes: tạo user ebank -> quyết định compliance -> (nếu NEED_REVIEW thì dừng chờ compliance officer duyệt qua HUMAN task) -> finalize/notify -> cleanup -> audit. TRƯỚC KHI SYNC FILE NÀY: phải tạo User Form 'ComplianceReviewForm' (Definitions > User Forms) và group 'compliance-reviewers' (Access Control > Groups) trên Orkes Cloud UI, 2 thứ này không định nghĩa được trong workflow JSON.",
  "version": 5,
  "tasks": [
    {
      "name": "create_ebank_user",
      "taskReferenceName": "create_ebank_user_ref",
      "description": "GHI DỮ LIỆU — non-idempotent. cccdData/nfcData/livenessData là mock được pre-flow generate sẵn và truyền thẳng vào workflow.input, không còn qua OCR/Liveness/NFC task nào trong Orkes. Bắt buộc idempotencyKey, taskdef retryCount=0.",
      "inputParameters": {
        "customerId": "${workflow.input.customerId}",
        "phone": "${workflow.input.phone}",
        "cccdData": "${workflow.input.cccdData}",
        "nfcData": "${workflow.input.nfcData}",
        "livenessData": "${workflow.input.livenessData}",
        "productType": "${workflow.input.productType}",
        "tncAccepted": "${workflow.input.tncAccepted}",
        "idempotencyKey": "${workflow.workflowId}-create-user"
      },
      "type": "SIMPLE",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
      "permissive": false,
      "metadata": {}
    },
    {
      "name": "process_account_in_conductor",
      "taskReferenceName": "process_account_in_conductor_ref",
      "description": "Xử lý compliance/nhóm KH. Trả về status = SUCCESS | NEED_REVIEW | FAILED.",
      "inputParameters": {
        "ebankUserId": "${create_ebank_user_ref.output.ebankUserId}",
        "accountNumber": "${create_ebank_user_ref.output.accountNumber}",
        "phone": "${workflow.input.phone}",
        "productType": "${workflow.input.productType}",
        "forceComplianceResult": "${workflow.input.forceComplianceResult}"
      },
      "type": "SIMPLE",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "onStateChange": {},
      "permissive": false,
      "metadata": {}
    },
    {
      "name": "route_compliance_result",
      "taskReferenceName": "route_compliance_result_ref",
      "description": "Chỉ rẽ vào HUMAN task khi thật sự cần người quyết định (NEED_REVIEW). SUCCESS/FAILED đi thẳng xuống finalize_account_result_ref, không qua case nào ở đây.",
      "inputParameters": {
        "switchCaseValue": "${process_account_in_conductor_ref.output.status}"
      },
      "type": "SWITCH",
      "decisionCases": {
        "NEED_REVIEW": [
          {
            "name": "compliance_review",
            "taskReferenceName": "compliance_review_ref",
            "description": "HUMAN task thật — compliance officer xem hồ sơ NEED_REVIEW và quyết định APPROVE/REJECT qua User Form trên Orkes Task Inbox (hoặc UI riêng dùng Human Tasks API). userFormTemplate 'ComplianceReviewForm' và group 'compliance-reviewers' PHẢI được tạo trước trên Orkes Cloud UI, không tạo được qua workflow JSON.",
            "inputParameters": {
              "customerId": "${workflow.input.customerId}",
              "phone": "${workflow.input.phone}",
              "failureReason": "${process_account_in_conductor_ref.output.failureReason}",
              "cccdData": "${workflow.input.cccdData}",
              "assignments": [
                {
                  "assignee": {
                    "userType": "EXTERNAL_GROUP",
                    "user": "compliance-reviewers"
                  },
                  "slaMinutes": 240
                }
              ],
              "displayName": "Compliance Review",
              "userFormTemplate": {
                "name": "ComplianceReviewForm",
                "version": 1
              },
              "assignmentCompletionStrategy": "LEAVE_OPEN"
            },
            "type": "HUMAN",
            "decisionCases": {},
            "defaultCase": [],
            "forkTasks": [],
            "startDelay": 0,
            "joinOn": [],
            "optional": false,
            "defaultExclusiveJoinTask": [],
            "asyncComplete": false,
            "loopOver": [],
            "onStateChange": {},
            "permissive": false,
            "metadata": {}
          }
        ]
      },
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
      "optional": false,
      "defaultExclusiveJoinTask": [],
      "asyncComplete": false,
      "loopOver": [],
      "evaluatorType": "value-param",
      "expression": "switchCaseValue",
      "onStateChange": {},
      "permissive": false,
      "metadata": {}
    },
    {
      "name": "finalize_account_result",
      "taskReferenceName": "finalize_account_result_ref",
      "description": "Gộp notify_vendor_*/send_ott_*/create_link_id thành 1 task. Nhận cả status gốc (SUCCESS/FAILED/NEED_REVIEW) lẫn reviewDecision (chỉ có giá trị nếu đã đi qua compliance_review_ref) — worker Java tự quyết: có reviewDecision thì ưu tiên dùng (map APPROVE->SUCCESS, REJECT->FAILED), không có thì dùng status gốc. Output resolvedStatus/resolvedFailureReason là nguồn sự thật cuối cùng cho audit + workflow output.",
      "inputParameters": {
        "vendorId": "${workflow.input.vendorId}",
        "customerId": "${workflow.input.customerId}",
        "phone": "${workflow.input.phone}",
        "ebankUserId": "${create_ebank_user_ref.output.ebankUserId}",
        "accountNumber": "${create_ebank_user_ref.output.accountNumber}",
        "status": "${process_account_in_conductor_ref.output.status}",
        "failureReason": "${process_account_in_conductor_ref.output.failureReason}",
        "reviewDecision": "${compliance_review_ref.output.reviewDecision}",
        "reviewNotes": "${compliance_review_ref.output.reviewNotes}",
        "idempotencyKey": "${workflow.workflowId}-finalize"
      },
      "type": "SIMPLE",
      "decisionCases": {},
      "defaultCase": [],
      "forkTasks": [],
      "startDelay": 0,
      "joinOn": [],
